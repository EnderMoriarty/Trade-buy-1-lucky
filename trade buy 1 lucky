-- === УТИЛИТА: нажать кнопку ===
local function trigger(obj)
    local sig = obj.MouseButton1Down
    if sig then
        local ok, conns = pcall(function() return getconnections(sig) end)
        if ok and conns and #conns > 0 then
            local ok2 = pcall(function() conns[1].Function() end)
            if ok2 then return true end
        end
    end
    sig = obj.MouseButton1Click
    if sig then
        local ok, conns = pcall(function() return getconnections(sig) end)
        if ok and conns and #conns > 0 then
            local ok2 = pcall(function() conns[1].Function() end)
            if ok2 then return true end
        end
    end
    return false
end

-- === ПОИСК ИГРОКА ===
local function findPlayer(query)
    query = query:lower()
    if query == "" then return nil end
    local best, bestP = nil, 999
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local n = p.Name:lower()
        local d = p.DisplayName:lower()
        local pr = 999
        if n == query then pr = 1
        elseif n:sub(1, #query) == query then pr = 2
        elseif d:sub(1, #query) == query then pr = 3
        elseif n:find(query, 1, true) then pr = 4
        elseif d:find(query, 1, true) then pr = 5
        end
        if pr < bestP then bestP = pr; best = p end
    end
    return best
end

-- === КУПИТЬ 1 ЛАКИ ===
local function buyOneLucky()
    local main = player.PlayerGui.HUD.Main
    local store = main.Frames:FindFirstChild("Store")
    if not store then setStatus("❌ Store не найден", Color3.fromRGB(255, 75, 75)) return end
    
    -- Открываем магазин
    setStatus("⏳ Открываю магазин...", Color3.fromRGB(255, 200, 75))
    local toggleStore = main:FindFirstChild("ToggleStore")
    if toggleStore then trigger(toggleStore) end
    task.wait(1.5)
    
    -- Прокрутка
    setStatus("⏳ Прокручиваю до ItemShop...", Color3.fromRGB(255, 200, 75))
    local list = store:FindFirstChild("List")
    if list then
        list.CanvasPosition = Vector2.new(0, 700)
        task.wait(0.5)
    end
    
    local itemShop = list and list:FindFirstChild("ItemShop")
    if not itemShop then 
        setStatus("❌ ItemShop не найден", Color3.fromRGB(255, 75, 75))
        return 
    end
    
    -- Покупаем 1 раз
    local arrow = itemShop:FindFirstChild("1x Lucky Arrow", true)
    if not arrow then 
        setStatus("❌ Lucky Arrow не найдена", Color3.fromRGB(255, 75, 75))
        return 
    end
    
    setStatus("⏳ Клик по Lucky Arrow...", Color3.fromRGB(255, 200, 75))
    trigger(arrow)
    task.wait(1.5)
    
    -- Confirmation
    local confirm = store:FindFirstChild("Confirmation")
    if not confirm or not confirm.Visible then
        setStatus("⚠️ Confirmation не появился", Color3.fromRGB(255, 200, 75))
        if toggleStore then trigger(toggleStore) end
        return
    end
    
    setStatus("⏳ Клик по Yes...", Color3.fromRGB(255, 200, 75))
    local yes = confirm:FindFirstChild("Yes")
    if yes then
        trigger(yes)
        task.wait(1.5)
    end
    
    -- Закрываем магазин
    if toggleStore then trigger(toggleStore) end
    
    -- Проверяем
    task.wait(0.5)
    local count = 0
    for _, item in ipairs(player.Backpack:GetChildren()) do
        if item.Name == "Lucky Arrow" then count = count + 1 end
    end
    
    setStatus("✅ Куплено! Лаки в Backpack: " .. count, Color3.fromRGB(75, 255, 75))
end

-- === ОТПРАВИТЬ ТРЕЙД ===
local function sendTrade()
    local query = NameInput.Text:gsub("^%s*(.-)%s*$", "%1")
    
    if query == "" then
        setStatus("❌ Введи ник!", Color3.fromRGB(255, 75, 75))
        return
    end
    
    setStatus("🔍 Ищу '" .. query .. "'...", Color3.fromRGB(255, 200, 75))
    local target = findPlayer(query)
    if not target then
        setStatus("❌ Игрок '" .. query .. "' не найден", Color3.fromRGB(255, 75, 75))
        return
    end
    
    setStatus("✅ Найден: " .. target.Name, Color3.fromRGB(75, 255, 75))
    task.wait(0.3)
    
    local living = workspace:WaitForChild("Living", 5)
    if not living then setStatus("❌ Living не найден", Color3.fromRGB(255, 75, 75)) return end
    local myFolder = living:FindFirstChild(player.Name)
    if not myFolder then setStatus("❌ Папка не найдена", Color3.fromRGB(255, 75, 75)) return end
    local remote = myFolder:FindFirstChild("RemoteFunction")
    if not remote then setStatus("❌ Remote не найден", Color3.fromRGB(255, 75, 75)) return end
    
    setStatus("⏳ Отправляю трейд...", Color3.fromRGB(255, 200, 75))
    remote:InvokeServer("InitiateCosmeticTrade", target.Name)
    
    setStatus("✅ Трейд отправлен " .. target.Name, Color3.fromRGB(75, 255, 75))
end

