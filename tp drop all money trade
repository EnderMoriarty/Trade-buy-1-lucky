-- === ПОИСК ИГРОКА ===
local function findPlayer(query)
    query = query:lower()
    if query == "" then return nil end
    local best, bestP = nil, 999
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local n = p.Name:lower()
        local d = p.DisplayName:lower()
        local pr = 999
        if n == query then pr = 1
        elseif n:sub(1, #query) == query then pr = 2
        elseif d:sub(1, #query) == query then pr = 3
        elseif n:find(query, 1, true) then pr = 4
        elseif d:find(query, 1, true) then pr = 5
        end
        if pr < bestP then bestP = pr; best = p end
    end
    return best
end

-- === ТП ПЕРЕД ЛИЦОМ (рывками) ===
local function smoothTeleport(target)
    local targetChar = target.Character
    local myChar = player.Character
    if not targetChar or not myChar then return false end
    
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot or not myRoot then return false end
    
    local STEP = 30
    local DELAY = 0.05
    local maxIter = 200
    
    for i = 1, maxIter do
        if not targetRoot.Parent or not myRoot.Parent then return false end
        
        local finalPos = targetRoot.Position + (targetRoot.CFrame.LookVector * 3.5)
        local myPos = myRoot.Position
        local dist = (finalPos - myPos).Magnitude
        
        if dist <= STEP then
            myRoot.CFrame = CFrame.lookAt(finalPos, targetRoot.Position)
            return true
        end
        
        local dir = (finalPos - myPos).Unit
        myRoot.CFrame = CFrame.lookAt(myPos + (dir * STEP), targetRoot.Position)
        task.wait(DELAY)
    end
    return false
end

-- === СБРОС ВСЕХ ДЕНЕГ ===
local function dropAllMoney()
    local hud = player.PlayerGui:FindFirstChild("HUD")
    if not hud then return false end
    local main = hud:FindFirstChild("Main")
    if not main then return false end
    local dropFrame = main:FindFirstChild("DropMoney")
    if not dropFrame then return false end
    
    -- Читаем баланс
    local moneyLabel = dropFrame:FindFirstChild("Money")
    if not moneyLabel then return false end
    local balance = tonumber(moneyLabel.Text:match("%d+")) or 0
    if balance <= 0 then return false end
    
    print("💰 Баланс:", balance)
    
    -- Открываем окно
    dropFrame.Visible = true
    task.wait(0.3)
    
    -- Поле ввода
    local input = dropFrame:FindFirstChild("DropAmount") 
               or dropFrame:FindFirstChildOfClass("TextBox")
    if not input then return false end
    
    input.Visible = true
    task.wait(0.2)
    input:CaptureFocus()
    task.wait(0.2)
    input.Text = ""
    task.wait(0.1)
    input.Text = tostring(balance)
    task.wait(0.3)
    
    -- Enter
    VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.1)
    VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    task.wait(0.5)
    
    dropFrame.Visible = false
    return true
end

-- === ОТПРАВКА ТРЕЙДА ===
local function sendTrade(target)
    local living = workspace:WaitForChild("Living", 5)
    if not living then return false end
    local myFolder = living:FindFirstChild(player.Name)
    if not myFolder then return false end
    local remote = myFolder:FindFirstChild("RemoteFunction")
    if not remote then return false end
    
    remote:InvokeServer("InitiateCosmeticTrade", target.Name)
    return true
end

-- === ПОЛНЫЙ ЦИКЛ ===
local function fullCycle()
    local query = NameInput.Text:gsub("^%s*(.-)%s*$", "%1")
    
    if query == "" then
        setStatus("❌ Введи ник!", Color3.fromRGB(255, 75, 75))
        return
    end
    
    setStatus("🔍 Ищу '" .. query .. "'...", Color3.fromRGB(255, 200, 75))
    local target = findPlayer(query)
    if not target then
        setStatus("❌ Игрок не найден", Color3.fromRGB(255, 75, 75))
        return
    end
    setStatus("✅ Найден: " .. target.Name, Color3.fromRGB(75, 255, 75))
    task.wait(0.3)
    
    -- ТП
    setStatus("⏳ ТП рывками...", Color3.fromRGB(255, 200, 75))
    smoothTeleport(target)
    task.wait(0.5)
    
    -- СБРОС
    setStatus("⏳ Сброс всех денег...", Color3.fromRGB(255, 200, 75))
    local dropped = dropAllMoney()
    task.wait(0.5)
    
    -- ТРЕЙД
    setStatus("⏳ Отправляю трейд...", Color3.fromRGB(255, 200, 75))
    sendTrade(target)
    
    if dropped then
        setStatus("✅ ТП + СБРОС + ТРЕЙД ВЫПОЛНЕНО!", Color3.fromRGB(75, 255, 75))
    else
        setStatus("⚠️ Трейд отправлен, но деньги не сброшены", Color3.fromRGB(255, 200, 75))
    end
end

